---
/* 전후 비교 — 스크롤에 따라 BEFORE가 걷히며 AFTER가 드러납니다.
   좁은 화면과 모션 최소화 설정에서는 두 장을 위아래로 나란히 보여줍니다. */
interface Props {
  beforeLabel?: string; afterLabel?: string;
  beforeCaption: string; afterCaption: string;
  beforeSrc?: string; afterSrc?: string;
  beforeAlt?: string; afterAlt?: string;
}
const {
  beforeLabel = 'BEFORE', afterLabel = 'AFTER', beforeCaption, afterCaption,
  beforeSrc = '/before.webp', afterSrc = '/after.webp',
  beforeAlt = '리뉴얼 전 기업 홈페이지 예시 화면: 작은 글씨와 많은 메뉴, 오래된 레이아웃',
  afterAlt = '리뉴얼 후 기업 홈페이지 예시 화면: 큰 제목과 정리된 메뉴, 문의 버튼이 보이는 레이아웃',
} = Astro.props;
---
<div class="wipe" data-wipe>
  <div class="wipe__stage">
    <img class="wipe__img wipe__img--after" src={afterSrc} width="2640" height="1776" alt={afterAlt} loading="lazy" decoding="async" />
    <div class="wipe__clip" data-wipe-clip>
      <img class="wipe__img wipe__img--before" src={beforeSrc} width="2640" height="1776" alt={beforeAlt} loading="lazy" decoding="async" />
    </div>
    <div class="wipe__bar" data-wipe-bar aria-hidden="true"><span class="wipe__knob"></span></div>
    <p class="wipe__tag wipe__tag--b" data-wipe-tag-b>{beforeLabel}</p>
    <p class="wipe__tag wipe__tag--a" data-wipe-tag-a>{afterLabel}</p>
  </div>

  <div class="wipe__caps">
    <p class="wipe__cap wipe__cap--b" data-wipe-cap-b>{beforeCaption}</p>
    <p class="wipe__cap wipe__cap--a" data-wipe-cap-a>{afterCaption}</p>
  </div>
</div>
<p class="ba__note">실제 고객사 화면이 아니라, 설계 방식을 보여주기 위해 만든 예시입니다.</p>
