---
interface Props {
  beforeLabel?: string; afterLabel?: string;
  beforeCaption: string; afterCaption: string;
  beforeSrc?: string; afterSrc?: string;
  beforeAlt?: string; afterAlt?: string;
}
const {
  beforeLabel = 'BEFORE', afterLabel = 'AFTER', beforeCaption, afterCaption,
  beforeSrc = '/before.webp', afterSrc = '/after.webp',
  beforeAlt = '리뉴얼 전 기업 홈페이지 예시 화면: 작은 글씨와 많은 메뉴, 오래된 레이아웃',
  afterAlt = '리뉴얼 후 기업 홈페이지 예시 화면: 큰 제목과 정리된 메뉴, 문의 버튼이 보이는 레이아웃',
} = Astro.props;
---
<div class="ba" data-reveal>
  <figure class="ba__item ba__item--before">
    <div class="ba__tag">{beforeLabel}</div>
    <img class="ba__img" src={beforeSrc} width="690" height="467" alt={beforeAlt} loading="lazy" decoding="async" />
    <figcaption>{beforeCaption}</figcaption>
  </figure>

  <div class="ba__arrow" aria-hidden="true">
    <svg viewBox="0 0 48 24" width="48" height="24"><path d="M2 12h40m0 0-9-8m9 8-9 8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </div>

  <figure class="ba__item ba__item--after">
    <div class="ba__tag ba__tag--on">{afterLabel}</div>
    <img class="ba__img" src={afterSrc} width="690" height="467" alt={afterAlt} loading="lazy" decoding="async" />
    <figcaption>{afterCaption}</figcaption>
  </figure>
</div>
<p class="ba__note">실제 고객사 화면이 아니라, 설계 방식을 보여주기 위해 만든 예시입니다.</p>
