---
/* 고객 후기 — 두 줄이 서로 반대 방향으로 흐르는 마키.
   src/data/reviews.mjs 의 reviews 배열이 비어 있으면 섹션 자체가 렌더되지 않습니다. */
import { reviews, placeholder, source } from '../data/reviews.mjs';

const PREVIEW = import.meta.env.REVIEW_PREVIEW === 'true';
const items = reviews.length > 0 ? reviews : (PREVIEW ? placeholder : []);
const rowA = items.filter((_, i) => i % 2 === 0);
const rowB = items.filter((_, i) => i % 2 === 1);
const initial = (s) => (s || '?').trim().charAt(0);
---
{items.length >= 4 && (
  <section class="sec sec--soft rv" id="reviews" aria-labelledby="rv-title">
    <div class="inner">
      <div class="head head--split" data-reveal>
        <div>
          <p class="label">REVIEW</p>
          <h2 id="rv-title" class="h2">맡기고 나서<br>달라진 점.</h2>
        </div>
        <p class="lead">직접 의뢰해 주신 분들이 남겨 주신 이야기입니다.<br><span class="rv__src">{source.label} · 평점 {source.rating} · 후기 {source.count}건</span></p>
      </div>
    </div>

    <div class="rv__rail" data-reveal>
      <div class="rv__row">
        <div class="rv__track">
          {[...rowA, ...rowA].map((r, i) => (
            <figure class="rv__card" aria-hidden={i >= rowA.length ? 'true' : undefined}>
              <figcaption class="rv__who">
                <span class="rv__ava" aria-hidden="true">{initial(r.company)}</span>
                <span class="rv__meta"><b>{r.company}</b><span>{r.name}</span></span>
              </figcaption>
              <blockquote class="rv__txt">{r.text}</blockquote>
            </figure>
          ))}
        </div>
      </div>
      <div class="rv__row rv__row--rev">
        <div class="rv__track">
          {[...rowB, ...rowB].map((r, i) => (
            <figure class="rv__card" aria-hidden={i >= rowB.length ? 'true' : undefined}>
              <figcaption class="rv__who">
                <span class="rv__ava" aria-hidden="true">{initial(r.company)}</span>
                <span class="rv__meta"><b>{r.company}</b><span>{r.name}</span></span>
              </figcaption>
              <blockquote class="rv__txt">{r.text}</blockquote>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
