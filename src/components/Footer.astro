---
import site from '../site.config.mjs';
const b = site.business;
---
<footer class="ft">
  <div class="inner ft__in">
    <div>
      <p class="ft__logo">{site.logo ?? site.name}</p>
      <p class="ft__info">
        {b.company} · 대표 {b.ceo}<br>
        전화 <a href={`tel:${site.contact.tel}`}>{site.contact.tel}</a>
      </p>
    </div>
    <div class="ft__right">
      <p class="ft__links">
        <a href="/privacy">개인정보처리방침</a>
        <a href={site.contact.kakao} target="_blank" rel="noopener">카카오톡 상담</a>
      </p>
      <p class="ft__copy">© {new Date().getFullYear()} {site.name}</p>
    </div>
  </div>
</footer>
