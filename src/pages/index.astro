---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import LatestColumns from '../components/LatestColumns.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Reviews from '../components/Reviews.astro';
import FlowStage from '../components/FlowStage.astro';
import site from '../site.config.mjs';

const faqs = [
  { q: '기업 홈페이지 리뉴얼은 보통 얼마나 걸리나요?', a: '상담부터 오픈까지 2주를 기준으로 진행합니다. 자료 준비 상황과 페이지 수에 따라 일정은 조정될 수 있습니다.' },
  { q: '기존 홈페이지 내용을 그대로 옮길 수 있나요?', a: '기존 내용을 먼저 검토해서 살릴 내용과 새로 써야 할 내용을 나눕니다. 필요한 내용은 옮기고, 오래된 정보는 정리합니다.' },
  { q: '자료가 하나도 정리되어 있지 않은데 괜찮을까요?', a: '괜찮습니다. 회사소개서, 제안서, 사진처럼 가지고 계신 자료를 그대로 보내주시면 메뉴 구조와 페이지별 내용으로 정리하는 것부터 함께 진행합니다.' },
  { q: '리뉴얼 후에 회사에서 직접 수정할 수 있나요?', a: '관리자 페이지를 제공하고, 오픈할 때 1:1로 수정 방법을 안내합니다. 문구와 이미지 정도는 담당자가 직접 바꿀 수 있습니다.' },
  { q: '모바일 화면도 함께 바뀌나요?', a: 'PC와 모바일 화면을 함께 설계하고 구현합니다. 요즘은 모바일로 먼저 보는 경우가 많아 모바일 가독성을 특히 신경 씁니다.' },
  { q: '리뉴얼하면 검색에도 잘 나오나요?', a: '페이지 제목과 설명, 제목 구조, 이미지 설명, 사이트맵 같은 검색 노출 기본 설정을 함께 진행합니다. 상위 노출은 콘텐츠와 운영 기간에 따라 달라지므로 보장하지는 않습니다.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, inLanguage: 'ko-KR' },
  {
    '@context': 'https://schema.org', '@type': 'Service',
    name: '기업 홈페이지 리뉴얼', serviceType: '홈페이지 리뉴얼',
    description: '흩어진 자료 정리부터 구조 설계, 디자인, 반응형 개발, 운영 교육까지 진행하는 기업 홈페이지 리뉴얼 서비스',
    areaServed: 'KR',
    provider: { '@type': 'ProfessionalService', name: site.name, url: site.url, telephone: site.contact.tel, email: site.contact.email },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },

  {
    '@context': 'https://schema.org', '@type': 'Organization',
    name: site.business.company, url: site.url, telephone: site.contact.tel,
    areaServed: { '@type': 'Country', name: '대한민국' },
    knowsLanguage: 'ko-KR',
    contactPoint: [{ '@type': 'ContactPoint', telephone: site.contact.tel,
      contactType: 'customer service', areaServed: 'KR', availableLanguage: 'Korean' }],
  },
  {
    '@context': 'https://schema.org', '@type': 'HowTo',
    name: '기업 홈페이지 리뉴얼 진행 과정',
    description: '상담부터 오픈까지 2주를 기준으로 진행합니다. 기간은 자료 준비 상황과 작업 스케줄에 따라 달라질 수 있습니다.',
    totalTime: 'P14D',
    step: [
      { '@type': 'HowToStep', position: 1, name: '상담 · 자료 정리', text: '기존 홈페이지와 보유 자료를 함께 검토합니다.' },
      { '@type': 'HowToStep', position: 2, name: '구조 설계', text: '메뉴와 페이지별 내용을 새로 설계합니다.' },
      { '@type': 'HowToStep', position: 3, name: '디자인', text: '시안으로 방향을 맞추고 수정합니다.' },
      { '@type': 'HowToStep', position: 4, name: '개발 · 반응형', text: 'PC와 모바일 화면을 실제 사이트로 구현합니다.' },
      { '@type': 'HowToStep', position: 5, name: '오픈 · 운영 교육', text: '도메인을 연결하고 운영 방법을 1:1로 안내합니다.' }
    ],
  },
];
---
<Base
  title="기업 홈페이지 리뉴얼 | 오래된 회사 홈페이지, 2주 만에 새로 - 리빌드웹"
  description="회사는 성장했는데 홈페이지는 그대로인가요? 리빌드웹은 흩어진 자료 정리부터 구조 설계, 디자인, 모바일 반응형, 운영 교육까지 기업 홈페이지 리뉴얼을 2주 동안 진행합니다."
  schema={schema}
>
  <!-- 히어로 → 전환 구간 (아래에서 위로 걷히는 덮기) -->
  <div class="cv" data-curtain>
    <div class="cv__a">
      <div class="cv__a-stage">
    <!-- 히어로 -->
    <section class="hero hero--dark">
      <div class="hero__grad" aria-hidden="true"></div>
      <div class="hero__orb" aria-hidden="true"></div>
      <div class="inner hero__grid">
        <div class="hero__copy">
        <p class="hero__kw" data-reveal>기업 홈페이지 리뉴얼</p>
        <h1 class="h1" data-reveal>오래된 회사 홈페이지,<br>2주 만에 다시 짓습니다.</h1>
        <p class="lead" data-reveal>회사는 성장했는데 홈페이지는 몇 년 전 그대로인가요? 리빌드웹은 흩어진 자료 정리부터 디자인, 개발, 운영 교육까지 기업 홈페이지 리뉴얼을 한 번에 진행합니다.</p>
        <div class="hero__btns" data-reveal>
          <a class="btn" href="#contact">무료 리뉴얼 상담 →</a>
          <a class="btn btn--line" href="#signs">리뉴얼이 필요한지 확인하기</a>
        </div>
        </div>
        <figure class="hero__shot" data-reveal>
          <img src="/devices.webp" width="1920" height="1307" alt="리뉴얼한 기업 홈페이지의 PC·모바일 화면 예시" loading="eager" decoding="async" fetchpriority="high">
          <figcaption>설계 방식을 보여주는 예시 화면입니다</figcaption>
        </figure>
        <ul class="hero__points" data-reveal-group>
          <li><strong>2주 완성</strong><span>상담부터 오픈까지 정해진 일정</span></li>
          <li><strong>자료 정리부터</strong><span>뒤섞인 자료도 구조로 정리</span></li>
          <li><strong>직접 운영 교육</strong><span>오픈 후 회사에서 바로 수정</span></li>
        </ul>
      </div>
      <p class="hero__scroll" aria-hidden="true">SCROLL</p>
    </section>
      </div>
    </div>

    <div class="cv__b">
      <div class="cv__b-stage">
        <div class="inner cv__grid">
          <div class="cv__b-in">
            <p class="label">THE GAP</p>
            <h2 class="cv__h">회사는 그동안<br><em>달라졌습니다.</em></h2>
            <ol class="cv__list" data-gap-list>
              <li class="is-on"><b>직원이 늘었습니다</b><span>사람이 늘면 보여줄 것도 늘어납니다.</span></li>
              <li><b>서비스가 바뀌었습니다</b><span>지금 하는 일이 홈페이지에 없습니다.</span></li>
              <li><b>거래처가 달라졌습니다</b><span>보는 사람이 바뀌면 할 말도 바뀝니다.</span></li>
            </ol>
            <p class="cv__sub">그런데 홈페이지만 그 자리에 멈춰 있습니다.</p>
            <a class="btn cv__cta" href="#signs">우리 홈페이지는 어떤지 확인하기 →</a>
          </div>

          <div class="cv__cards" aria-hidden="true" data-gap-cards>
            <figure class="cv__card is-on"><img src="/gap-team.webp" width="880" height="1100" alt="" loading="lazy" decoding="async"></figure>
            <figure class="cv__card"><img src="/gap-work.webp" width="880" height="1100" alt="" loading="lazy" decoding="async"></figure>
            <figure class="cv__card"><img src="/gap-client.webp" width="880" height="1100" alt="" loading="lazy" decoding="async"></figure>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 수치 -->
  <section class="statbar" aria-label="주요 수치">
    <div class="inner">
      <ul class="statbar__in">
        <li data-reveal><strong><span class="num" data-count="100">100</span><small>+</small></strong><span>누적 프로젝트</span></li>
        <li data-reveal><strong><span class="num" data-count="2">2</span><small>주</small></strong><span>상담부터 오픈까지</span></li>
        <li data-reveal><strong><span class="num" data-count="2">2</span><small>개월</small></strong><span>오픈 후 무상 케어</span></li>
      </ul>
      <p class="statbar__note">진행 기간은 자료 준비 상황과 작업 스케줄에 따라 달라질 수 있습니다.</p>
    </div>
  </section>

  <!-- 리뉴얼 신호 -->
  <section class="sec sec--soft sec--lift" id="signs" aria-labelledby="signs-title">
    <div class="inner split">
      <div class="split__l" data-reveal>
        <p class="label">CHECK</p>
        <h2 id="signs-title" class="h2">이 중 2개 이상이면,<br>리뉴얼을 고민할 때입니다.</h2>
        <p class="split__note">대부분의 회사는 홈페이지가 낡았다는 걸 알면서도,<br class="br-pc">어디서부터 손대야 할지 몰라 미룹니다.</p>
      </div>
      <ol class="signs" data-signs data-reveal-group>
        <li>
          <label class="signs__row">
            <input type="checkbox" class="signs__cb">
            <span class="signs__n">01</span>
            <span class="signs__box" aria-hidden="true"></span>
            <span class="signs__t">모바일로 보면 글자가 작거나 화면이 깨진다</span>
          </label>
        </li>
        <li>
          <label class="signs__row">
            <input type="checkbox" class="signs__cb">
            <span class="signs__n">02</span>
            <span class="signs__box" aria-hidden="true"></span>
            <span class="signs__t">회사 소개와 실적이 몇 년 전 내용에 멈춰 있다</span>
          </label>
        </li>
        <li>
          <label class="signs__row">
            <input type="checkbox" class="signs__cb">
            <span class="signs__n">03</span>
            <span class="signs__box" aria-hidden="true"></span>
            <span class="signs__t">홈페이지를 통해 들어오는 문의가 거의 없다</span>
          </label>
        </li>
        <li>
          <label class="signs__row">
            <input type="checkbox" class="signs__cb">
            <span class="signs__n">04</span>
            <span class="signs__box" aria-hidden="true"></span>
            <span class="signs__t">문구 하나 바꾸려 해도 제작 업체에 연락해야 한다</span>
          </label>
        </li>
        <li>
          <label class="signs__row">
            <input type="checkbox" class="signs__cb">
            <span class="signs__n">05</span>
            <span class="signs__box" aria-hidden="true"></span>
            <span class="signs__t">회사 이름으로 검색해도 홈페이지가 잘 나오지 않는다</span>
          </label>
        </li>
        <li>
          <label class="signs__row">
            <input type="checkbox" class="signs__cb">
            <span class="signs__n">06</span>
            <span class="signs__box" aria-hidden="true"></span>
            <span class="signs__t">거래처에 주소를 알려주기가 망설여진다</span>
          </label>
        </li>
      </ol>
      <div class="signs__result" data-signs-result aria-live="polite">
        <p class="signs__count"><b>0</b><span>개 선택</span></p>
        <p class="signs__msg">해당하는 항목을 눌러 보세요.</p>
        <a class="btn signs__cta" href="#contact">무료 리뉴얼 상담 →</a>
      </div>
    </div>
  </section>

  <!-- 리뉴얼 범위 -->
  <section class="sec sec--lift" id="scope" aria-labelledby="scope-title">
    <div class="inner">
      <div class="head head--split" data-reveal>
        <div>
          <p class="label">WHAT CHANGES</p>
          <h2 id="scope-title" class="h2">디자인만 바꾸지 않습니다.<br>구조부터 다시 짓습니다.</h2>
        </div>
        <p class="lead">리뉴얼이 실패하는 가장 흔한 이유는 겉모습만 바꾸고 내용과 구조는 그대로 두는 것입니다. 저희는 메뉴 구조와 문장부터 다시 세운 뒤에 화면을 올립니다.</p>
      </div>
      <BeforeAfter
        beforeCaption="메뉴가 많고 글이 빽빽합니다. 무엇을 먼저 봐야 할지 알 수 없고, 문의로 가는 길도 없습니다."
        afterCaption="회사가 하는 일이 한눈에 들어오고, 서비스를 읽은 방문자가 바로 상담으로 이어집니다."
      />
    </div>
  </section>

  <FlowStage />


  <!-- 전환 띠 -->
  <section
    class="band band--hwf sec--lift"
    aria-label="핵심 메시지"
    data-halftone
    data-word="rebuild"
    data-bg="#0A0E18"
    data-ink="#D9DCE4"
    data-warm="#5A7DFF"
    data-gap="7"
    data-crop="0.3"
    data-radius="110"
  >
    <canvas class="hwf__canvas" aria-hidden="true"></canvas>
    <div class="inner">
      <p>방문자는 홈페이지를 <em>3초</em> 동안 봅니다.<br>그 3초가 회사의 인상을 결정합니다.</p>
      <a class="btn band__cta" href="#contact">무료 리뉴얼 상담 →</a>
    </div>
  </section>

  <!-- 전후 비교 -->
  <section class="sec sec--dark bento" aria-labelledby="bento-title">
    <div class="inner">
      <div class="head head--split" data-reveal>
        <div>
          <p class="label">SCOPE</p>
          <h2 id="bento-title" class="h2">리뉴얼에<br>포함되는 것.</h2>
        </div>
        <p class="lead">여섯 가지를 한 번에 진행합니다. 따로 발주하거나 다른 업체를 찾을 필요가 없습니다.</p>
      </div>
      <ol class="bento__grid">
        <li class="bento__t bento--w" data-reveal style="--bg:url('/bt-1.webp')">
          <span class="bento__n">01</span>
          <h3 class="bento__h">메뉴 구조 재설계</h3>
          <p class="bento__d">방문자가 찾는 순서대로 메뉴와 페이지를 다시 나눕니다. 회사 조직도 순서가 아니라, 고객이 궁금해하는 순서입니다.</p>
        </li>
        <li class="bento__t " data-reveal style="--bg:url('/bt-2.webp')">
          <span class="bento__n">02</span>
          <h3 class="bento__h">회사 소개 카피 정리</h3>
          <p class="bento__d">흩어진 자료를 읽히는 문장으로 정리합니다. 몇 년 전 회사가 아니라 지금의 회사를 담습니다.</p>
        </li>
        <li class="bento__t " data-reveal style="--bg:url('/bt-3.webp')">
          <span class="bento__n">03</span>
          <h3 class="bento__h">신뢰를 주는 디자인</h3>
          <p class="bento__d">회사 규모와 업종에 맞는 톤으로 PC와 모바일 화면을 함께 설계합니다.</p>
        </li>
        <li class="bento__t " data-reveal style="--bg:url('/bt-4.webp')">
          <span class="bento__n">04</span>
          <h3 class="bento__h">문의로 이어지는 동선</h3>
          <p class="bento__d">서비스를 본 방문자가 자연스럽게 문의까지 가도록 버튼과 폼을 배치합니다.</p>
        </li>
        <li class="bento__t " data-reveal style="--bg:url('/bt-5.webp')">
          <span class="bento__n">05</span>
          <h3 class="bento__h">검색 노출 기본 설정</h3>
          <p class="bento__d">페이지 제목과 설명, 사이트맵 등록까지 검색엔진이 읽기 좋게 세팅합니다.</p>
        </li>
        <li class="bento__t bento--w" data-reveal style="--bg:url('/bt-6.webp')">
          <span class="bento__n">06</span>
          <h3 class="bento__h">직접 운영 교육</h3>
          <p class="bento__d">관리자 페이지 사용법을 1:1로 안내해 오픈 후 회사에서 바로 운영합니다.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="sec sec--soft sec--lift" aria-labelledby="compare-title">
    <div class="inner">
      <div class="head" data-reveal>
        <p class="label">BEFORE · AFTER</p>
        <h2 id="compare-title" class="h2">리뉴얼 전과 후, 이렇게 달라집니다.</h2>
      </div>
      <div class="table-wrap" data-reveal>
        <table class="compare">
          <caption class="skip">기업 홈페이지 리뉴얼 전후 비교</caption>
          <thead><tr><th scope="col">항목</th><th scope="col">리뉴얼 전</th><th scope="col">리뉴얼 후</th></tr></thead>
          <tbody>
            <tr><th scope="row">메뉴 구조</th><td>회사 조직 순서대로 나열</td><td class="is-good">방문자가 찾는 순서대로 정리</td></tr>
            <tr><th scope="row">모바일 화면</th><td>PC 화면을 줄여서 보여줌</td><td class="is-good">모바일 전용 배치와 글자 크기</td></tr>
            <tr><th scope="row">문의</th><td>연락처만 하단에 표시</td><td class="is-good">페이지마다 상담 버튼과 문의폼 연결</td></tr>
