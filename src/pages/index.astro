---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import LatestColumns from '../components/LatestColumns.astro';
import site from '../site.config.mjs';

const faqs = [
  { q: '기업 홈페이지 리뉴얼은 보통 얼마나 걸리나요?', a: '상담부터 오픈까지 6주를 기준으로 진행합니다. 자료 준비 상황과 페이지 수에 따라 일정은 조정될 수 있습니다.' },
  { q: '기존 홈페이지 내용을 그대로 옮길 수 있나요?', a: '기존 내용을 먼저 검토해서 살릴 내용과 새로 써야 할 내용을 나눕니다. 필요한 내용은 옮기고, 오래된 정보는 정리합니다.' },
  { q: '자료가 하나도 정리되어 있지 않은데 괜찮을까요?', a: '괜찮습니다. 회사소개서, 제안서, 사진처럼 가지고 계신 자료를 그대로 보내주시면 메뉴 구조와 페이지별 내용으로 정리하는 것부터 함께 진행합니다.' },
  { q: '리뉴얼 후에 회사에서 직접 수정할 수 있나요?', a: '관리자 페이지를 제공하고, 오픈할 때 1:1로 수정 방법을 안내합니다. 문구와 이미지 정도는 담당자가 직접 바꿀 수 있습니다.' },
  { q: '모바일 화면도 함께 바뀌나요?', a: 'PC와 모바일 화면을 함께 설계하고 구현합니다. 요즘은 모바일로 먼저 보는 경우가 많아 모바일 가독성을 특히 신경 씁니다.' },
  { q: '리뉴얼하면 검색에도 잘 나오나요?', a: '페이지 제목과 설명, 제목 구조, 이미지 설명, 사이트맵 같은 검색 노출 기본 설정을 함께 진행합니다. 상위 노출은 콘텐츠와 운영 기간에 따라 달라지므로 보장하지는 않습니다.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, inLanguage: 'ko-KR' },
  {
    '@context': 'https://schema.org', '@type': 'Service',
    name: '기업 홈페이지 리뉴얼', serviceType: '홈페이지 리뉴얼',
    description: '흩어진 자료 정리부터 구조 설계, 디자인, 반응형 개발, 운영 교육까지 진행하는 기업 홈페이지 리뉴얼 서비스',
    areaServed: 'KR',
    provider: { '@type': 'ProfessionalService', name: site.name, url: site.url, telephone: site.contact.tel, email: site.contact.email },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title="기업 홈페이지 리뉴얼 | 오래된 회사 홈페이지, 6주 만에 새로 - 리빌드웹"
  description="회사는 성장했는데 홈페이지는 그대로인가요? 리빌드웹은 흩어진 자료 정리부터 구조 설계, 디자인, 모바일 반응형, 운영 교육까지 기업 홈페이지 리뉴얼을 6주 동안 진행합니다."
  schema={schema}
>
  <!-- 히어로 -->
  <section class="hero">
    <div class="inner">
      <p class="hero__kw">기업 홈페이지 리뉴얼</p>
      <h1 class="h1">오래된 회사 홈페이지,<br>6주 만에 다시 짓습니다.</h1>
      <p class="lead">회사는 성장했는데 홈페이지는 몇 년 전 그대로인가요? 리빌드웹은 흩어진 자료 정리부터 디자인, 개발, 운영 교육까지 기업 홈페이지 리뉴얼을 한 번에 진행합니다.</p>
      <div class="hero__btns">
        <a class="btn" href="#contact">무료 리뉴얼 상담 →</a>
        <a class="btn btn--line" href="#signs">리뉴얼이 필요한지 확인하기</a>
      </div>
      <ul class="hero__points">
        <li><strong>6주 완성</strong><span>상담부터 오픈까지 정해진 일정</span></li>
        <li><strong>자료 정리부터</strong><span>뒤섞인 자료도 구조로 정리</span></li>
        <li><strong>직접 운영 교육</strong><span>오픈 후 회사에서 바로 수정</span></li>
      </ul>
    </div>
  </section>

  <!-- 리뉴얼 신호 -->
  <section class="sec sec--soft" id="signs" aria-labelledby="signs-title">
    <div class="inner">
      <div class="head">
        <p class="label">CHECK</p>
        <h2 id="signs-title" class="h2">이 중 2개 이상이면,<br>홈페이지 리뉴얼을 고민할 때입니다.</h2>
      </div>
      <ul class="checks">
        <li>모바일로 보면 글자가 작거나 화면이 깨진다</li>
        <li>회사 소개와 실적이 몇 년 전 내용에 멈춰 있다</li>
        <li>홈페이지를 통해 들어오는 문의가 거의 없다</li>
        <li>문구 하나 바꾸려 해도 제작 업체에 연락해야 한다</li>
        <li>회사 이름으로 검색해도 홈페이지가 잘 나오지 않는다</li>
        <li>거래처에 주소를 알려주기가 망설여진다</li>
      </ul>
    </div>
  </section>

  <!-- 리뉴얼 범위 -->
  <section class="sec" aria-labelledby="scope-title">
    <div class="inner">
      <div class="head">
        <p class="label">WHAT CHANGES</p>
        <h2 id="scope-title" class="h2">디자인만 바꾸지 않습니다.<br>구조부터 다시 짓습니다.</h2>
        <p class="lead">리뉴얼이 실패하는 가장 흔한 이유는 겉모습만 바꾸고 내용과 구조는 그대로 두는 것입니다.</p>
      </div>
      <ul class="cards">
        <li class="card"><span class="card__no">01</span><h3>메뉴 구조 재설계</h3><p>방문자가 찾는 순서대로 메뉴와 페이지를 다시 나눕니다.</p></li>
        <li class="card"><span class="card__no">02</span><h3>회사 소개 카피 정리</h3><p>흩어진 자료를 읽히는 문장으로 정리해 회사의 현재 모습을 담습니다.</p></li>
        <li class="card"><span class="card__no">03</span><h3>신뢰를 주는 디자인</h3><p>회사 규모와 업종에 맞는 톤으로 PC와 모바일 화면을 함께 설계합니다.</p></li>
        <li class="card"><span class="card__no">04</span><h3>문의로 이어지는 동선</h3><p>서비스를 본 방문자가 자연스럽게 문의까지 가도록 버튼과 폼을 배치합니다.</p></li>
        <li class="card"><span class="card__no">05</span><h3>검색 노출 기본 설정</h3><p>페이지 제목과 설명, 사이트맵 등록까지 검색엔진이 읽기 좋게 세팅합니다.</p></li>
        <li class="card"><span class="card__no">06</span><h3>직접 운영 교육</h3><p>관리자 페이지 사용법을 1:1로 안내해 오픈 후 회사에서 바로 운영합니다.</p></li>
      </ul>
    </div>
  </section>

  <!-- 전후 비교 -->
  <section class="sec sec--soft" aria-labelledby="compare-title">
    <div class="inner">
      <div class="head">
        <p class="label">BEFORE · AFTER</p>
        <h2 id="compare-title" class="h2">리뉴얼 전과 후, 이렇게 달라집니다.</h2>
      </div>
      <div class="table-wrap">
        <table class="compare">
          <caption class="skip">기업 홈페이지 리뉴얼 전후 비교</caption>
          <thead><tr><th scope="col">항목</th><th scope="col">리뉴얼 전</th><th scope="col">리뉴얼 후</th></tr></thead>
          <tbody>
            <tr><th scope="row">메뉴 구조</th><td>회사 조직 순서대로 나열</td><td class="is-good">방문자가 찾는 순서대로 정리</td></tr>
            <tr><th scope="row">모바일 화면</th><td>PC 화면을 줄여서 보여줌</td><td class="is-good">모바일 전용 배치와 글자 크기</td></tr>
            <tr><th scope="row">문의</th><td>연락처만 하단에 표시</td><td class="is-good">페이지마다 상담 버튼과 문의폼 연결</td></tr>
            <tr><th scope="row">내용 수정</th><td>제작 업체에 요청</td><td class="is-good">관리자 페이지에서 직접 수정</td></tr>
            <tr><th scope="row">검색 노출</th><td>제목 · 설명 미설정</td><td class="is-good">페이지별 제목 · 설명 · 사이트맵 등록</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 진행 과정 -->
  <section class="sec sec--dark" id="process" aria-labelledby="process-title">
    <div class="inner">
      <div class="head">
        <p class="label">PROCESS</p>
        <h2 id="process-title" class="h2">기업 홈페이지 리뉴얼,<br>6주 동안 이렇게 진행됩니다.</h2>
      </div>
      <ol class="steps">
        <li><b>WEEK 1</b><h3>상담 · 자료 정리</h3><p>기존 홈페이지와 자료를 함께 검토합니다.</p></li>
        <li><b>WEEK 1–2</b><h3>구조 설계</h3><p>메뉴와 페이지별 내용을 새로 설계합니다.</p></li>
        <li><b>WEEK 2–3</b><h3>디자인</h3><p>시안으로 방향을 맞추고 수정합니다.</p></li>
        <li><b>WEEK 4–5</b><h3>개발 · 반응형</h3><p>모바일까지 실제 사이트로 구현합니다.</p></li>
        <li><b>WEEK 6</b><h3>오픈 · 운영 교육</h3><p>도메인 연결 후 운영 방법을 안내합니다.</p></li>
      </ol>
    </div>
  </section>

  <LatestColumns title="리뉴얼 전에 읽어보면 좋은 글" />

  <!-- FAQ -->
  <section class="sec sec--soft" id="faq" aria-labelledby="faq-title">
    <div class="inner inner--narrow">
      <div class="head">
        <p class="label">FAQ</p>
        <h2 id="faq-title" class="h2">기업 홈페이지 리뉴얼<br>자주 묻는 질문</h2>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <Contact
    title="지금 홈페이지 주소만 알려주세요."
    lead="무엇을 살리고 무엇을 바꾸면 좋을지, 리뉴얼 방향을 먼저 정리해 드립니다. 상담은 무료입니다."
  />
</Base>
