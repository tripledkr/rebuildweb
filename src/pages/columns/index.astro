---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import site from '../../site.config.mjs';

const posts = (await getCollection('columns', ({ data }) => !data.draft || import.meta.env.SHOW_DRAFTS === 'true'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
const title = `${site.columns.title} | ${site.name}`;
---
<Base
  title={title}
  description={site.columns.description}
  schema={[
    { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, url: new URL('/columns', site.url).href },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: site.url },
      { '@type': 'ListItem', position: 2, name: '칼럼', item: new URL('/columns', site.url).href },
    ]},
  ]}
>
  <section class="pagehead">
    <div class="inner">
      <nav class="crumb" aria-label="현재 위치"><a href="/">홈</a><span aria-hidden="true">/</span><span>칼럼</span></nav>
      <h1 class="h1">{site.columns.title}</h1>
      <p class="lead">{site.columns.description}</p>
    </div>
  </section>
  <section class="sec">
    <div class="inner">
      {posts.length === 0 && <p class="lead">첫 칼럼을 준비하고 있습니다.</p>}
      <ul class="plist">
        {posts.map((p, i) => (
          <li>
            <a class="plist__a" href={`/columns/${p.id}`}>
              <span class="plist__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="plist__body">
                <span class="plist__cat">{p.data.category}</span>
                <h2 class="plist__t">{p.data.title}</h2>
                <span class="plist__d">{p.data.description}</span>
                <time class="plist__date" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              </span>
              <span class="plist__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
